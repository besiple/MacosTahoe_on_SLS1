 bool tglCSB12Enabled {false};
+
+// Dynamic Render ForceWake management for Tiger Lake / Alder Lake.
+// Replaces permanent forcewake leak (-wex-tgl-hold-render-wake / 18W idle)
+// and submit-only bracket (which caused WAIT_ON_SCANLINE GPU hangs).
+// ForceWake is acquired on submit and held throughout execution.
+// It is released via thread_call after the GPU has been idle for the timeout duration.
+static thread_call_t tglRenderWakeCall {nullptr};
+static void *tglRenderWakeOwnerCurrent {nullptr};
+static void *tglRenderWakeStreamer {nullptr};
+static uint32_t tglRenderWakeActive {0}; // 0 = idle/released, 1 = active/held
+static uint32_t tglRCSBusy {0}; // 1 = context active on RCS, 0 = idle
+static uint64_t tglRenderWakeLastSubmit {0}; // uptime ticks
+static uint64_t tglRenderWakeSeq {0};
+static uint64_t tglRenderWakeTimeoutNs {250ULL * 1000ULL * 1000ULL}; // 250ms default
+static bool tglRenderWakeHoldForever {false};
+static uint64_t tglRenderWakeAcquires {0};
+static uint64_t tglRenderWakeSuspends {0};
+static uint64_t tglRenderWakeDeclines {0};
+
+static void tglRenderWakeTimerCallback(thread_call_param_t, thread_call_param_t) {
+ auto owner = tglRenderWakeOwnerCurrent;
+ if (!owner) return;
+
+ uint64_t now;
+ clock_get_uptime(&now);
+ const uint64_t last = __atomic_load_n(&tglRenderWakeLastSubmit, __ATOMIC_ACQUIRE);
+ uint64_t timeoutTicks = 0;
+ nanoseconds_to_absolutetime(tglRenderWakeTimeoutNs, &timeoutTicks);
+
+ if (now >= last && (now - last) < timeoutTicks) {
+  thread_call_enter_delayed(tglRenderWakeCall, last + timeoutTicks);
+  return;
+ }
+
+ if (__atomic_load_n(&tglRCSBusy, __ATOMIC_ACQUIRE)) {
+  __atomic_fetch_add(&tglRenderWakeDeclines, 1ULL, __ATOMIC_RELAXED);
+  uint64_t recheckTicks = 0;
+  nanoseconds_to_absolutetime(50ULL * 1000ULL * 1000ULL, &recheckTicks);
+  thread_call_enter_delayed(tglRenderWakeCall, now + recheckTicks);
+  return;
+ }
+
+ const uint64_t seqBefore = __atomic_load_n(&tglRenderWakeSeq, __ATOMIC_ACQUIRE);
+ uint32_t expected = 1;
+ if (!__atomic_compare_exchange_n(&tglRenderWakeActive, &expected, 0U, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+  return;
+ }
+
+ const uint64_t seqAfter = __atomic_load_n(&tglRenderWakeSeq, __ATOMIC_ACQUIRE);
+ if (seqBefore != seqAfter || __atomic_load_n(&tglRCSBusy, __ATOMIC_ACQUIRE)) {
+  uint32_t back = 0;
+  if (__atomic_compare_exchange_n(&tglRenderWakeActive, &back, 1U, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+   uint64_t delayTicks = 0;
+   nanoseconds_to_absolutetime(tglRenderWakeTimeoutNs, &delayTicks);
+   thread_call_enter_delayed(tglRenderWakeCall, now + delayTicks);
+   return;
+  }
+ }
+
+ tglCSBForceWake[0](owner, false, 1);
+ __atomic_fetch_add(&tglRenderWakeSuspends, 1ULL, __ATOMIC_RELAXED);
+}
+
+static bool tglRenderWakeSerialize(void *, void *, OSSerialize *serializer) {
+ uint64_t values[8] {};
+ values[0] = __atomic_load_n(&tglRenderWakeActive, __ATOMIC_RELAXED);
+ values[1] = __atomic_load_n(&tglRenderWakeAcquires, __ATOMIC_RELAXED);
+ values[2] = __atomic_load_n(&tglRenderWakeSuspends, __ATOMIC_RELAXED);
+ values[3] = tglRenderWakeTimeoutNs / 1000000ULL;
+ values[4] = __atomic_load_n(&tglRenderWakeSeq, __ATOMIC_RELAXED);
+ if (tglRenderWakeOwnerCurrent) {
+  values[5] = *reinterpret_cast<volatile uint32_t *>(static_cast<uint8_t *>(tglRenderWakeOwnerCurrent) + 0x1290);
+ }
+ values[6] = __atomic_load_n(&tglRCSBusy, __ATOMIC_RELAXED);
+ values[7] = __atomic_load_n(&tglRenderWakeDeclines, __ATOMIC_RELAXED);
+ auto data = OSData::withBytes(values, sizeof(values));
+ if (!data) return false;
+ const bool ok = data->serialize(serializer);
+ data->release();
+ return ok;
+}
 struct TGLCSBEngine {
  void *streamer {};
  TGLCSB::State state;
@@ -15190,6 +15273,19 @@ bool XE::installTGLCSB12(KernelPatcher &patcher,size_t index,mach_vm_address_t a
   if (data) {root->setProperty("TGLCSB12Live",data);data->release();}
   auto modes=OSSerializer::forTarget(nullptr,tglCSBModeSerialize);
   if (modes) {root->setProperty("TGLCSBModeAtInit",modes);modes->release();}
+  tglRenderWakeHoldForever = checkKernelArgument("-wex-tgl-hold-render-wake");
+  if (!tglRenderWakeHoldForever) {
+   uint32_t timeoutMs = 250;
+   PE_parse_boot_argn("-wex-tgl-wake-timeout", &timeoutMs, sizeof(timeoutMs));
+   if (timeoutMs < 10) timeoutMs = 10;
+   if (timeoutMs > 5000) timeoutMs = 5000;
+   tglRenderWakeTimeoutNs = static_cast<uint64_t>(timeoutMs) * 1000ULL * 1000ULL;
+   if (!tglRenderWakeCall)
+    tglRenderWakeCall = thread_call_allocate(tglRenderWakeTimerCallback, nullptr);
+  }
+  root->setProperty("TGLRenderWakeAutosuspend", !tglRenderWakeHoldForever);
+  auto wakeLive = OSSerializer::forTarget(nullptr, tglRenderWakeSerialize);
+  if (wakeLive) {root->setProperty("TGLRenderWakeLive", wakeLive); wakeLive->release();}
  }
  tglCSB12Enabled=ok;patcher.clearError();return ok;
 }
@@ -15209,8 +15305,16 @@ bool XE::wrapTGLCSBInit(void *streamer,void *owner,void *loop,void *scheduler,un
  }
  return ok;
 }
-void XE::wrapTGLCSBWake(void *streamer) { tglCSBInitialize(streamer); }
+void XE::wrapTGLCSBWake(void *streamer) {
+ if (tglRenderWakeCall) thread_call_cancel(tglRenderWakeCall);
+ __atomic_store_n(&tglRenderWakeActive, 0U, __ATOMIC_RELEASE);
+ __atomic_store_n(&tglRCSBusy, 0U, __ATOMIC_RELEASE);
+ tglCSBInitialize(streamer);
+}
 void XE::wrapTGLCSBReset(void *streamer) {
+ if (tglRenderWakeCall) thread_call_cancel(tglRenderWakeCall);
+ __atomic_store_n(&tglRenderWakeActive, 0U, __ATOMIC_RELEASE);
+ __atomic_store_n(&tglRCSBusy, 0U, __ATOMIC_RELEASE);
  tglCSBInitialize(streamer);
  FunctionCast(wrapTGLCSBReset,callbackXE->orgTGLCSBReset)(streamer);
 }
