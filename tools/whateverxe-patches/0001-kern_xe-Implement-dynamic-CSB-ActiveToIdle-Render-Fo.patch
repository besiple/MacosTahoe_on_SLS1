    q[49]=q[50]=q[114]=UINT64_MAX;
   }
-  tglCSBForceWake[0](renderWakeOwner,true,1);
+  uint32_t expected = 0;
+  if (__atomic_compare_exchange_n(&tglRenderWakeActive, &expected, 1U, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
